{
  "$comment": "Fuente de verdad de los tokens. `npm run tokens` genera prototypes/itinerante-b4/tokens.css; el sitio raíz solo se verifica contra su tema (`npm run critique`).",
  "scales": {
    "space": {
      "1": 4,
      "2": 8,
      "3": 12,
      "4": 16,
      "5": 24,
      "6": 32,
      "7": 48,
      "8": 64,
      "9": 96,
      "10": 128
    },
    "type": {
      "0": "0.75rem",
      "1": "0.875rem",
      "2": "1rem",
      "3": "1.125rem",
      "4": "1.375rem",
      "5": "1.75rem",
      "6": "2.25rem",
      "7": "3rem"
    },
    "radius": {
      "1": "2px",
      "2": "4px",
      "3": "8px",
      "4": "16px",
      "pill": "999px"
    },
    "duration": {
      "instant": "120ms",
      "fast": "240ms",
      "base": "400ms",
      "slow": "700ms",
      "scene": "1200ms"
    },
    "hair": {
      "base": "1px",
      "dense": "0.5px"
    },
    "target": {
      "fine": 24,
      "coarse": 44
    },
    "measure": {
      "min": 45,
      "max": 75
    },
    "contrast": {
      "text": 4.5,
      "large": 3
    }
  },
  "themes": {
    "b4": {
      "color": {
        "night": "#100d0a",
        "night-2": "#17120e",
        "stone": "#241e18",
        "bone": "#f1e8d8",
        "bone-dim": "#b8aa95",
        "line": "rgb(241 232 216 / 0.14)",
        "line-strong": "rgb(241 232 216 / 0.34)",
        "field": "rgb(241 232 216 / 0.62)",
        "tungsten": "#f0b357",
        "tungsten-hi": "#f7cc86",
        "turq": "#34b3a5",
        "turq-ink": "#062824",
        "turq-light": "#8fe0d5",
        "terra": "#c45a3c",
        "terra-deep": "#9e3f25",
        "terra-ink": "#7a2c16",
        "paper": "#efe6d5",
        "paper-ink": "#1a1510",
        "paper-dim": "#5e5245"
      },
      "font": {
        "f-sans": "\"Archivo\", Arial, Helvetica, system-ui, sans-serif",
        "f-serif": "\"Bodoni Moda\", \"Didot\", \"Bodoni 72\", Georgia, serif"
      },
      "ease": {
        "ease-out": "cubic-bezier(0.16, 1, 0.3, 1)",
        "ease-io": "cubic-bezier(0.65, 0, 0.35, 1)"
      },
      "layout": {
        "gutter": "clamp(16px, 3.2vw, 48px)",
        "hdr-h": "68px"
      },
      "root": {
        "color-scheme": "dark",
        "interpolate-size": "allow-keywords"
      },
      "print": {
        "night": "#fff",
        "night-2": "#fff",
        "stone": "#eee",
        "bone": "#000",
        "bone-dim": "#333",
        "tungsten": "#000",
        "turq": "#fff",
        "turq-ink": "#000",
        "paper": "#fff",
        "paper-ink": "#000",
        "paper-dim": "#333",
        "terra": "#000",
        "terra-deep": "#000",
        "terra-ink": "#000",
        "line": "#999",
        "line-strong": "#666"
      }
    },
    "root": {
      "color": {
        "brand": "#5dc4b4",
        "brand-deep": "#0d4a45",
        "brand-ink": "#061a18",
        "brand-light": "#9de3da",
        "amber": "#e8a020",
        "turquoise-deep": "#3d6660",
        "status-error": "#8a241d",
        "status-error-light": "#f0b3ab",
        "paper": "#fdfcf8",
        "paper-bright": "#ffffff",
        "line": "rgba(93, 196, 180, .2)"
      }
    }
  }
}
