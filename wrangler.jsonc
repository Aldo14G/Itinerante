{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "libreria-itinerante",
  "main": "worker/nuevo.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "previews": {},
  "observability": { "enabled": false },
  "vars": { "PUBLIC_SITE_ORIGIN": "https://libreria-itinerante.aldo14g.workers.dev" },
  "assets": {
    // Solo archivos referenciados por /nuevo. El build histórico queda fuera de este destino.
    "directory": "./.wrangler/nuevo-assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/robots.txt", "/sitemap.xml", "/nuevo", "/nuevo/", "/index", "/index/", "/index.html", "/index.html/", "/prototypes", "/prototypes/*", "/_archive", "/_archive/*"]
  }
}
